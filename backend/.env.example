# Copy to .env and fill in.

SECRET_KEY=dev-only-not-a-real-secret
DEBUG=True

# Supabase → Project Settings → Database → Connection string → URI (use the pooler, port 6543).
# Leave EMPTY to fall back to local SQLite — handy when the venue wifi hates you.
DATABASE_URL=

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Phase 2 only. Until these are set, the API uses the mock token backend.
FIREBASE_CREDENTIALS_JSON=
